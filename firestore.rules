rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Testler
    match /quizzes/{quizId} {
      // Herkes (anonim dahil) bir testi okuyabilir — link ile açan oynayabilsin.
      allow read: if true;

      // Yalnızca giriş yapmış kullanıcı, kendi adına (creatorId == uid) test
      // oluşturabilir ve alan biçimleri doğruysa.
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.cat is string
        && request.resource.data.name is string
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 30
        && request.resource.data.playCount == 0;

      // Testi yalnızca sahibi güncelleyebilir/silebilir.
      // (playCount artışı client'ta yapılıyor; sahibi olmayan değiştiremez.)
      allow update, delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;

      // Gizli sahip verisi (push token): yalnızca test sahibi okuyabilir/yazabilir.
      // Herkese açık quiz dokümanından ayrı tutulur ki token sızmasın.
      // Cloud Function admin yetkisiyle okur (kurallar onu bağlamaz).
      match /private/{doc} {
        allow read, create, delete: if request.auth != null
          && get(/databases/$(database)/documents/quizzes/$(quizId)).data.creatorId == request.auth.uid;
        allow update: if false;
      }

      // Sonuçlar. CİHAZ BAŞINA TEK ÇÖZÜM:
      // Link/kod ile çözümde doküman kimliği = çözenin uid'si. update kapalı
      // olduğu için aynı cihaz aynı testi ikinci kez KAYDEDEMEZ — sunucu
      // tarafında garanti (istemci değiştirilse bile geçerli).
      // "Aynı telefonda oyna" akışı kimliğe zaman damgası ekler (uid_...),
      // böylece kurucu telefonunu arkadaşına uzatabilir; her çözüm kaydolur.
      // Her iki durumda da solverId yazanın uid'si olmak zorunda: sonuçlar
      // daima kimliğe bağlı, sahibi olmayan adına sonuç yazılamaz.
      match /results/{resultId} {
        // GERİYE DÖNÜK UYUMLULUK: Play'deki eski sürümler saveResult'ta
        // oturum açmıyor ve solverId göndermiyordu. Kural sadece yeni biçimi
        // kabul etseydi o kullanıcıların sonuçları kaydedilemez, test
        // sahiplerine bildirim gitmezdi. Eski sürümler tükenince alttaki
        // "solverId yok" dalı kaldırılmalı (bkz. hafıza notu).
        allow create: if (
            (request.auth != null
              && request.resource.data.solverId == request.auth.uid)
            || !('solverId' in request.resource.data)
          )
          && request.resource.data.percent is int
          && request.resource.data.percent >= 0
          && request.resource.data.percent <= 100
          && request.resource.data.correct is int
          && request.resource.data.correct >= 0
          && request.resource.data.total is int
          && request.resource.data.total > 0
          && request.resource.data.total <= 30
          && request.resource.data.correct <= request.resource.data.total
          // guesses: çözenin işaretledikleri ("hangi soruda yanıldı" ekranı).
          // Eski sürümler göndermiyor, o yüzden isteğe bağlı.
          && (!('guesses' in request.resource.data)
            || (request.resource.data.guesses is list
              && request.resource.data.guesses.size() <= 30))
          && exists(/databases/$(database)/documents/quizzes/$(quizId));
        // Test sahibi tüm sonuçları, çözen ise yalnızca kendi kaydını okur
        // (istemci "bu testi zaten çözdüm mü?" kontrolünü bununla yapar).
        allow read: if request.auth != null
          && (resultId == request.auth.uid
            || get(/databases/$(database)/documents/quizzes/$(quizId)).data.creatorId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // Huni analitiği: istemci yalnızca olay EKLEYEBİLİR, hiçbirini okuyamaz.
    // İnceleme Firebase Console / BigQuery üzerinden (admin) yapılır.
    // GÜVENLİK: kimlik doğrulaması ZORUNLU ve olay adı bilinen listeden
    // olmalı. Aksi hâlde internetteki herkes sınırsız doküman yazıp
    // Firestore faturasını şişirebilirdi (maliyet saldırısı).
    match /events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.event in [
          'test_olusturuldu', 'test_paylasildi', 'link_acildi',
          'test_baslatildi', 'test_cozuldu', 'sonuc_paylasildi',
          'bildirim_acildi', 'uygulama_indir_tiklandi'
        ];
      allow read, update, delete: if false;
    }
  }
}
