{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "q" }],
      "destination": "/api/share"
    }
  ]
}
