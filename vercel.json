{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/",
      "has": [{ "type": "query", "key": "q" }],
      "dest": "/api/share"
    },
    { "handle": "filesystem" }
  ]
}
